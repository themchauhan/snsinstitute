# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.snsinstitute.in

# Enquiry form → Gmail (needs 2-Step Verification + an App Password: myaccount.google.com/apppasswords)
GMAIL_USER=yourinstitute@gmail.com
GMAIL_APP_PASSWORD=
# Where enquiries are delivered (comma-separated). Defaults to GMAIL_USER if empty.
ENQUIRY_EMAIL_TO=
# Optional: also send every enquiry to a Google Sheet (Apps Script web-app URL)
ENQUIRY_WEBHOOK_URL=

# Google Search Console verification code (optional)
GOOGLE_SITE_VERIFICATION=
