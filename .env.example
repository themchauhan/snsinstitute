# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.snsinstitute.in

# Admin panel: GitHub repo that stores the content, e.g. your-username/snsinstitute.
# Leave empty locally to edit files directly on your computer.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Filled automatically into .env when you create the Keystatic GitHub App locally
# (npm run dev → http://localhost:3000/keystatic → "Create GitHub App"). Copy all four to Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Enquiry form → email (free account at resend.com)
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=you@example.com
ENQUIRY_EMAIL_FROM=SNS Website <enquiry@snsinstitute.in>
# Optional: also send every enquiry to a Google Sheet (Apps Script web-app URL)
ENQUIRY_WEBHOOK_URL=

# Google Search Console verification code (optional)
GOOGLE_SITE_VERIFICATION=
